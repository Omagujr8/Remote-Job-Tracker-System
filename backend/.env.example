# --- Database ---
# Local dev (SQLite, zero setup):
DATABASE_URL=sqlite:///./job_tracker.db
# Production (Postgres, e.g. Render/Railway free tier):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File storage ---
# "local" for dev, "cloudinary" for production (persists across free-tier redeploys)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email digest (optional, for weekly summary feature) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
# Shared secret so only your cron job can trigger the digest endpoint
DIGEST_TRIGGER_SECRET=change-this-too
